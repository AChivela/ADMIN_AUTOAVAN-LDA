<!DOCTYPE html>
<html lang="pt-AO">
<head>
<meta charset="utf-8"><meta name="theme-color" content="#16191d"><link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&display=swap" rel="stylesheet">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Gestão · Auto Avan, Lda</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#eef0f3;--card:#fff;--ink:#14202e;--mut:#5d6b7a;--line:#d8dde3;--in:#1f8a5b;--out:#c8402f;--acc:#d4202a;--head:#16191d;--steel:#3b4a5a}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1620;--card:#16222f;--ink:#e8edf2;--mut:#93a1af;--line:#27374a;--in:#3ec28a;--out:#ef6b58;--head:#0d0f12;--steel:#9db0c4}}
:root[data-theme="dark"]{--bg:#0e1620;--card:#16222f;--ink:#e8edf2;--mut:#93a1af;--line:#27374a;--in:#3ec28a;--out:#ef6b58;--head:#0d0f12;--steel:#9db0c4}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*:before,*:after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 "Segoe UI",system-ui,Arial,sans-serif}
[hidden]{display:none!important}
input,select,button,textarea{font:inherit;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:6px;padding:8px 10px}
button{cursor:pointer;font-weight:600}
button.pri{background:var(--acc);border-color:var(--acc);color:#fff}
:focus-visible{outline:3px solid var(--acc);outline-offset:1px}
h1,h2,h3{font-family:Georgia,serif;margin:0}
/* login */
.login{min-height:100vh;display:grid;grid-template-columns:1.1fr 1fr}
.lp{background:var(--head);color:#fff;padding:48px;display:flex;flex-direction:column;justify-content:flex-end;border-right:6px solid var(--acc)}
.lp h1{font-size:38px;line-height:1.1}.lp p{color:#b9c7d4;max-width:360px}
.lf{display:flex;align-items:center;justify-content:center;padding:24px}
.lf form{width:100%;max-width:340px;display:flex;flex-direction:column;gap:12px}
.lf label{display:flex;flex-direction:column;font-size:13px;color:var(--mut);gap:4px}
.err{color:var(--out);font-size:13px;min-height:18px}
@media (max-width:760px){.login{grid-template-columns:1fr}.lp{padding:28px;border-right:0;border-bottom:6px solid var(--acc)}.lp h1{font-size:28px}}
/* app */
header.top{background:var(--head);color:#fff;border-bottom:5px solid var(--acc);padding:10px 20px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
.logo{font:700 20px Georgia,serif}.logo small{display:block;font:12px "Segoe UI",sans-serif;color:#b9c7d4}
nav{display:flex;gap:4px;flex-wrap:wrap}
nav button{background:transparent;color:#d6e0ea;border:0;border-radius:6px}
nav button.on{background:rgba(255,255,255,.14);color:#fff;box-shadow:inset 0 -3px var(--acc)}
.who{font-size:13px;text-align:right;color:#d6e0ea}.who button{margin-left:8px;padding:4px 10px;font-size:12px}
.wrap{max-width:1080px;margin:0 auto;padding:16px}
.view{display:none}.view.on{display:block}
.bar0{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}.bar0 h2{margin-right:auto;font-size:21px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin:0 0 14px}
.kpi{background:var(--card);border:1px solid var(--line);border-left:5px solid var(--head);border-radius:8px;padding:10px 14px}
.kpi small{color:var(--mut);display:block}.kpi b{font:700 19px Georgia,serif}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:14px;margin-bottom:14px}
section.box{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:14px}
section.box h3{font-size:17px;border-bottom:2px solid var(--acc);padding-bottom:4px;margin-bottom:8px}
.r{display:flex;gap:8px;align-items:center;justify-content:space-between;padding:3px 0}
.r input:first-child:not(.v){flex:1;min-width:0}
.v{width:130px;text-align:right;font-variant-numeric:tabular-nums}
.lh{display:flex;justify-content:space-between;align-items:center;margin-top:8px;font-weight:600;color:var(--mut)}
.tot{border-top:1px solid var(--line);margin-top:4px;font-weight:700}
.fin{border-top:2px solid var(--ink);margin-top:6px;font-weight:700;font-size:16px}
.x{border:0;background:none;color:var(--out);padding:2px 6px;font-weight:700}
.lh .x,.add{color:var(--head);border:1px solid var(--line);font-size:13px}
.srv{border-bottom:1px solid var(--line);padding:6px 0;display:grid;grid-template-columns:1fr 1fr auto;gap:6px}.srv .w{grid-column:1/3}
.bar{margin:6px 0}.bar .t{display:flex;justify-content:space-between;font-size:13px}.bar .b{background:var(--bg);height:9px;border-radius:5px}.bar .b i{display:block;height:9px;border-radius:5px}
table{width:100%;border-collapse:collapse;font-size:14px}th,td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}
th{background:var(--bg);font-size:12px;color:var(--mut)}.n{text-align:right!important;font-variant-numeric:tabular-nums}
tfoot td{font-weight:700;border-top:2px solid var(--ink)}.sc{overflow-x:auto}
.tag{font-size:12px;padding:2px 8px;border-radius:10px;background:var(--bg);border:1px solid var(--line)}.tag.ok{color:var(--in);border-color:var(--in)}
.pos{color:var(--in)}.neg{color:var(--out)}
.printonly{display:none}.muted{color:var(--mut)}
details{margin:14px 0}textarea{width:100%;height:220px;font:13px ui-monospace,Consolas,monospace}
.lg{display:block;background-color:#fff;background-image:url(data:image/png;base64,);background-position:center;background-size:contain;background-repeat:no-repeat;background-origin:content-box}
.lgh{display:inline-block;vertical-align:middle;width:66px;height:52px;padding:4px;border-radius:8px}
.lgb{width:230px;height:182px;padding:12px;border-radius:14px;margin-bottom:22px}
.lgp{width:110px;height:84px;padding:0;margin-bottom:4px}
.logo .lt{vertical-align:middle;margin-left:10px;display:inline-block}
.fg{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}.fg label{display:flex;flex-direction:column;font-size:12px;color:var(--mut);gap:3px}
textarea.ta{height:96px;font:inherit;resize:vertical}
.tag.w{color:#b36b00;border-color:#b36b00}
a.btn{display:inline-flex;align-items:center;min-height:38px;padding:8px 12px;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--ink);font-weight:600;text-decoration:none}
/* oficina + telemóvel */
h1,h2,h3,.logo,.kpi b,.fin{font-family:"Oswald","Arial Narrow",Impact,sans-serif;letter-spacing:.4px}
header.top{position:sticky;top:0;z-index:20;border-bottom:0;padding-bottom:16px}
header.top:after{content:"";position:absolute;left:0;right:0;bottom:0;height:6px;background:repeating-linear-gradient(-45deg,var(--acc) 0 12px,#16191d 12px 24px)}
.gear{color:var(--acc);margin-bottom:16px}
.srv .w2{grid-column:2/4}
nav .s{display:none}
@media screen and (max-width:760px){
 body{font-size:16px}
 input,select,button,textarea{font-size:16px;min-height:44px}
 .wrap{padding:12px 12px 90px}
 header.top{padding:8px 14px 16px;flex-wrap:nowrap}
 .logo{font-size:18px}.logo small{display:none}
 .who{font-size:12px}.who #me{display:none}.who button{min-height:36px;margin:0}
 nav{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--head);padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px));border-top:4px solid var(--acc);display:flex;gap:2px}
 nav button{flex:1;padding:6px 2px;font-size:13px;min-height:50px;border-radius:8px}
 nav .l{display:none}nav .s{display:inline}
 .bar0 h2{flex-basis:100%}.bar0>*{flex:1 1 140px}
 .kpis{grid-template-columns:1fr 1fr;gap:8px}.kpi b{font-size:18px}
 .grid{grid-template-columns:1fr}
 .v{width:112px}.x{min-width:40px;min-height:40px}
 .srv{grid-template-columns:1fr auto}.srv>*,.srv .w2{grid-column:1/-1}.srv .xx{grid-column:2;grid-row:1}.srv .t1{grid-column:1;grid-row:1}
 table.cards thead{display:none}table.cards,table.cards tbody,table.cards tfoot,table.cards tr,table.cards td{display:block}
 table.cards tr{background:var(--card);border:1px solid var(--line);border-radius:8px;margin:8px 0;padding:6px 10px}
 table.cards td{display:flex;justify-content:space-between;gap:10px;border:0;padding:4px 0;white-space:normal;text-align:right!important}
 table.cards td:before{content:attr(data-label);color:var(--mut);text-align:left;font-weight:600}
 table.cards td:empty{display:none}
 .lf form{max-width:none}
}
@media print{textarea.ta{border:0!important;padding:0!important;background:transparent!important;color:#000!important;height:auto;min-height:48px}
 :root{--bg:#fff;--card:#fff;--ink:#000;--mut:#444;--line:#bbb;padding:0}
 body{background:#fff;font-size:11.5px}.wrap{padding:0;max-width:none}
 header.top,.noprint,.x,details,.lh .x{display:none!important}
 .printonly{display:block}.pl{border-bottom:3px solid #0f2a43;margin-bottom:10px;padding-bottom:6px}.pl h2{font-size:22px}
 section.box,.kpi{break-inside:avoid;border-radius:0}.grid{grid-template-columns:1fr 1fr;gap:10px}
 input{border:0!important;padding:0!important;background:transparent!important;color:#000!important}
 .sign{display:flex;gap:40px;margin-top:45px}.sign div{flex:1;border-top:1px solid #000;padding-top:4px;text-align:center}
 *{-webkit-print-color-adjust:exact;print-color-adjust:exact}@page{size:A4;margin:12mm}
}
</style>
</head>
<body><svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="g" viewBox="0 0 64 64"><g fill="none" stroke="currentColor"><circle cx="32" cy="32" r="25" stroke-width="9" stroke-dasharray="6.5 6.59"/><circle cx="32" cy="32" r="19" stroke-width="6"/><circle cx="32" cy="32" r="7" stroke-width="4"/></g></symbol></svg>
<div class="login" id="login">
 <div class="lp"><span class="lg lgb" role="img" aria-label="Auto Avan"></span><h1>Gestão Auto Avan</h1><p>Secretaria: entrada de viaturas, serviços realizados, caixa, banco e relatórios num só lugar.</p></div>
 <div class="lf"><form id="lf"><h2 id="lt">Entrar</h2><p class="muted" id="ls" style="margin:0"></p>
  <label id="ln" hidden>Nome completo<input id="nm" autocomplete="name"></label>
  <label>Utilizador<input id="us" autocomplete="username" required></label>
  <label>Palavra-passe<input id="pw" type="password" autocomplete="current-password" required minlength="6"></label>
  <div class="err" id="le" role="alert"></div><button class="pri" type="submit" id="lb">Entrar</button></form></div>
</div>

<div id="app" hidden>
<header class="top">
 <div class="logo"><span class="lg lgh" role="img" aria-label="Auto Avan"></span><span class="lt">Gestão<small>Secretaria · Auto Avan, Lda</small></span></div>
 <nav id="nav"><button data-v="painel"><span class="l">Painel</span><span class="s">Painel</span></button><button data-v="os"><span class="l">Viaturas</span><span class="s">Viaturas</span></button><button data-v="dia"><span class="l">Caixa diário</span><span class="s">Caixa</span></button><button data-v="hist"><span class="l">Resumo mensal</span><span class="s">Mês</span></button><button data-v="users" id="nu"><span class="l">Utilizadores</span><span class="s">Contas</span></button></nav>
 <div class="who"><span id="me"></span><button onclick="sair()">Sair</button></div>
</header>
<main class="wrap">
<div class="printonly pl"><span class="lg lgp"></span><h2>Auto Avan, Lda</h2><div id="ptitle"></div></div>

<div class="view" id="v-os">
 <div id="os-list"><div class="bar0 noprint"><h2>Entrada de viaturas</h2><input id="osq" type="search" placeholder="Pesquisar matrícula, cliente, viatura"><select id="osf" aria-label="Estado"></select><button class="pri" onclick="novaOS()">+ Nova entrada</button></div>
 <div class="sc"><table class="cards"><thead><tr><th>OS</th><th>Entrada</th><th>Viatura</th><th>Cliente</th><th>Estado</th><th class="n">Total</th><th class="n">Em dívida</th><th></th></tr></thead><tbody id="osb"></tbody></table></div></div>
 <div id="os-ed" hidden></div>
</div>

<div class="view" id="v-painel">
 <div class="bar0"><h2>Painel</h2></div><div class="kpis" id="pk2"></div><div class="grid"><section class="box"><h3>Viaturas por estado</h3><div id="c4"></div></section></div><div class="kpis" id="pk"></div>
 <div class="grid"><section class="box"><h3>Despesas diárias (últimos relatórios)</h3><div id="c1"></div></section>
 <section class="box"><h3>Saldo Banco + Caixa</h3><div id="c2"></div></section>
 <section class="box"><h3>Serviços do mês (viaturas)</h3><div id="c3"></div></section></div>
 <section class="box"><h3>Últimos relatórios</h3><div class="sc"><table class="cards"><thead><tr><th>Data</th><th class="n">Banco</th><th class="n">Despesas</th><th>Estado</th><th></th></tr></thead><tbody id="pl"></tbody></table></div><p id="pe" class="muted" hidden>Ainda não há relatórios. Abra “Relatório do dia” para começar.</p></section>
</div>

<div class="view" id="v-dia">
 <div class="bar0 noprint"><h2>Relatório do dia</h2>
  <input type="date" id="dt" aria-label="Data"><button onclick="novoDia()">Dia seguinte</button><button onclick="copiar()">Copiar p/ WhatsApp</button>
  <button id="bap" onclick="aprovar()">Aprovar</button><button id="bdel" onclick="eliminar()">Eliminar</button><button class="pri" onclick="window.print()">Imprimir / PDF</button></div>
 <div id="ed"><div class="kpis" id="kpis"></div><div class="grid" id="blocks"></div>
 <div class="grid"><section class="box"><h3>Despesas realizadas (Caixa)</h3><div id="dbars"></div></section><section class="box"><h3>Saldos finais por conta</h3><div id="sbars"></div></section></div>
 <div class="grid"><section class="box"><h3>Ausência no local de trabalho</h3><div id="aus"></div><button class="add noprint" onclick="E(()=>S.aus.push({n:'',m:''}))">+ ausência</button></section>
 <section class="box"><h3>Serviços realizados</h3><div id="srv"></div><datalist id="svl"><option value="Diagnóstico"><option value="Revisão geral"><option value="Mudança de óleo e filtros"><option value="Travões"><option value="Embraiagem"><option value="Suspensão"><option value="Distribuição"><option value="Eletricidade auto"><option value="Pneus e alinhamento"><option value="Chapa e pintura"></datalist><button class="add noprint" onclick="E(()=>S.srv.push({t:'Diagnóstico',c:'',r:''}))">+ serviço</button></section></div></div>
 <div class="muted" id="meta" style="font-size:13px"></div>
 <div class="printonly sign"><div>Assistente Financeira</div><div>Direção / Gerência</div></div>
 <details class="noprint"><summary>Texto para WhatsApp</summary><textarea id="wa" readonly></textarea></details>
</div>

<div class="view" id="v-hist">
 <div class="bar0 noprint"><h2>Histórico mensal</h2><input type="month" id="mm" aria-label="Mês"><button onclick="csv()">Exportar CSV</button><button class="pri" onclick="window.print()">Imprimir / PDF</button></div>
 <div class="kpis" id="hk"></div>
 <section class="box"><h3>Resumo por dia</h3><div class="sc"><table class="cards"><thead><tr><th>Data</th><th class="n">Banco</th><th class="n">Caixa</th><th class="n">Despesas</th><th class="n">Viaturas</th><th class="n">Ausências</th><th>Estado</th><th class="noprint"></th></tr></thead><tbody id="hr"></tbody><tfoot id="hf"></tfoot></table></div></section>
 <div class="printonly sign"><div>Assistente Financeira</div><div>Direção / Gerência</div></div>
</div>

<div class="view" id="v-users">
 <div class="bar0"><h2>Utilizadores</h2></div>
 <div class="grid"><section class="box"><h3>Contas com acesso</h3><div id="ul"></div></section>
 <section class="box"><h3>Nova conta</h3><form id="uf" style="display:flex;flex-direction:column;gap:8px">
  <input id="un" placeholder="Nome completo" required><input id="uu" placeholder="Utilizador" required><input id="up" type="password" placeholder="Palavra-passe (mín. 6)" minlength="6" required>
  <select id="ur"><option value="fin">Assistente Financeira</option><option value="dir">Direção</option></select><div class="err" id="ue"></div><button class="pri">Criar conta</button></form></section></div>
 <p class="muted" style="font-size:13px">Aviso: o acesso protege a utilização normal neste dispositivo. Os dados ficam guardados no navegador deste computador.</p>
</div>
</main>
</div>

<script>
const $=id=>document.getElementById(id),mem={};
const ld=(k,d)=>{try{const r=localStorage.getItem(k);return r?JSON.parse(r):d}catch(e){return mem[k]??d}};
const sv=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){mem[k]=v}};
const fmt=n=>{const[a,b]=Math.abs(n).toFixed(2).split(".");return(n<0?"-":"")+a.replace(/\B(?=(\d{3})+$)/g,".")+","+b};
const num=s=>{const x=parseFloat(String(s).replace(/\./g,"").replace(",",".").replace(/[^\d.\-]/g,""));return isNaN(x)?0:x};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const sum=a=>a.reduce((s,x)=>s+x.v,0),T2=a=>a.ini+sum(a.ent),F2=a=>T2(a)-sum(a.sai);
const dBR=d=>d.split("-").reverse().join("/"),RN={dir:"Direção",fin:"Assistente Financeira"};
const BL=[["banco","Banco"],["caixa","Caixa"],["fbanco","Área de formação · Banco"],["fcaixa","Área de formação · Caixa"]];
const SEC={banco:["Entradas","Saídas"],caixa:["Entradas (reforços)","Despesas realizadas"],fbanco:["Entradas","Saídas"],fcaixa:["Entradas","Saídas"]};
let USERS=ld("aa_users",[]),DB=ld("aa_db",{}),ME=null,S=null,date=new Date().toLocaleDateString("sv"),fails=0,lock=0;
const hash=async(p,s)=>[...new Uint8Array(await crypto.subtle.digest("SHA-256",new TextEncoder().encode(s+p)))].map(x=>x.toString(16).padStart(2,"0")).join("");
/* login */
function lmode(){const first=!USERS.length;$("lt").textContent=first?"Primeiro acesso":"Entrar";$("ls").textContent=first?"Crie a conta da Direção. Depois poderá criar a conta da Assistente Financeira.":"Introduza as suas credenciais.";$("ln").hidden=!first;$("lb").textContent=first?"Criar conta e entrar":"Entrar"}
$("lf").onsubmit=async e=>{e.preventDefault();const u=$("us").value.trim().toLowerCase(),p=$("pw").value;$("le").textContent="";
 if(Date.now()<lock){$("le").textContent="Demasiadas tentativas. Aguarde 30 segundos.";return}
 if(!USERS.length){const salt=crypto.randomUUID();USERS.push({u,n:$("nm").value.trim()||u,r:"dir",s:salt,h:await hash(p,salt)});sv("aa_users",USERS);entrar(USERS[0]);return}
 const x=USERS.find(y=>y.u===u);if(x&&await hash(p,x.s)===x.h){fails=0;entrar(x)}else{if(++fails>=5){lock=Date.now()+30000;fails=0}$("le").textContent="Utilizador ou palavra-passe incorretos."}};
function entrar(x){ME=x;try{sessionStorage.setItem("aa_me",x.u)}catch(e){}$("login").hidden=true;$("app").hidden=false;$("pw").value="";
 $("me").textContent=x.n+" · "+RN[x.r];$("nu").hidden=x.r!=="dir";$("bap").hidden=x.r!=="dir";$("bdel").hidden=x.r!=="dir";go("painel")}
function sair(){try{sessionStorage.removeItem("aa_me")}catch(e){}ME=null;$("app").hidden=true;$("login").hidden=false;lmode()}
/* navegação */
document.querySelectorAll("nav button").forEach(b=>b.onclick=()=>go(b.dataset.v));
function go(v){document.querySelectorAll(".view").forEach(x=>x.classList.toggle("on",x.id==="v-"+v));document.querySelectorAll("nav button").forEach(b=>b.classList.toggle("on",b.dataset.v===v));
 ({painel:P,os:osl,dia:openDay,hist:H,users:U})[v]()}
/* dia */
function blank(prev){const s={aus:[],srv:[]};BL.forEach(([k])=>s[k]={ini:prev?F2(prev[k]):0,ent:[],sai:[]});return s}
function openDay(){const ds=Object.keys(DB).sort().filter(d=>d<date);S=DB[date]||blank(ds.length?DB[ds[ds.length-1]]:null);$("dt").value=date;R()}
$("dt").onchange=e=>{date=e.target.value||date;openDay()};
function novoDia(){const d=new Date(date+"T12:00:00");d.setDate(d.getDate()+1);date=d.toLocaleDateString("sv");openDay()}
function E(fn){fn();S.by=ME.n;S.at=new Date().toISOString();DB[date]=S;sv("aa_db",DB);R()}
function aprovar(){if(!DB[date])return alert("Registe dados antes de aprovar.");S.apr=S.apr?null:ME.n;DB[date]=S;sv("aa_db",DB);R()}
function eliminar(){if(DB[date]&&confirm("Eliminar o relatório de "+dBR(date)+"?")){delete DB[date];sv("aa_db",DB);openDay()}}
function lst(k,w){return`<div class="lh"><span>${SEC[k][w=="ent"?0:1]}</span><button class="x" onclick="E(()=>S['${k}'].${w}.push({n:'',v:0}))">+ linha</button></div>`+
 S[k][w].map((x,i)=>`<div class="r"><input value="${esc(x.n)}" placeholder="Descrição" onchange="E(()=>S['${k}'].${w}[${i}].n=this.value)"><input class="v" value="${fmt(x.v)}" inputmode="decimal" onchange="E(()=>S['${k}'].${w}[${i}].v=num(this.value))"><button class="x" aria-label="Apagar" onclick="E(()=>S['${k}'].${w}.splice(${i},1))">✕</button></div>`).join("")}
function blk(k,t){const a=S[k];return`<section class="box"><h3>${t}</h3><div class="r"><span>Saldo inicial</span><input class="v" value="${fmt(a.ini)}" inputmode="decimal" onchange="E(()=>S['${k}'].ini=num(this.value))"></div>${lst(k,"ent")}<div class="r tot"><span>Total</span><span>${fmt(T2(a))}</span></div>${lst(k,"sai")}<div class="r fin"><span>Saldo final</span><span>${fmt(F2(a))} Kz</span></div></section>`}
function bars(it,c,u=" Kz",f=fmt){const mx=Math.max(1,...it.map(x=>x[1]));return it.length?it.map(([n,v])=>`<div class="bar"><div class="t"><span>${esc(n||"—")}</span><b>${f(v)}${u}</b></div><div class="b"><i style="width:${Math.max(1,v/mx*100)}%;background:${c}"></i></div></div>`).join(""):"<p class='muted'>Sem registos.</p>"}
function R(){const desp=sum(S.caixa.sai),locked=S.apr&&ME.r!=="dir";
 $("ptitle").innerHTML=`Relatório diário de ${dBR(date)} · Valores em Kwanzas (Kz)`;
 $("kpis").innerHTML=[["Saldo final · Banco",F2(S.banco)],["Saldo final · Caixa",F2(S.caixa)],["Despesas do dia",desp],["Banco + Caixa",F2(S.banco)+F2(S.caixa)]].map(([a,b])=>`<div class="kpi"><small>${a}</small><b>${fmt(b)} Kz</b></div>`).join("")+`<div class="kpi"><small>Viaturas atendidas</small><b>${S.srv.filter(x=>x.c.trim()).length}</b></div><div class="kpi"><small>Ausências</small><b>${S.aus.filter(x=>x.n.trim()).length}</b></div>`;
 $("blocks").innerHTML=BL.map(([k,t])=>blk(k,t)).join("");
 $("dbars").innerHTML=bars(S.caixa.sai.map(x=>[x.n,x.v]),"var(--out)")+`<div class="r tot"><span>Total das despesas</span><span>${fmt(desp)} Kz</span></div>`;
 $("sbars").innerHTML=bars(BL.map(([k,t])=>[t,Math.max(0,F2(S[k]))]),"var(--steel)");
 $("aus").innerHTML=S.aus.map((x,i)=>`<div class="r"><input value="${esc(x.n)}" placeholder="Nome" onchange="E(()=>S.aus[${i}].n=this.value)"><input value="${esc(x.m)}" placeholder="Motivo" onchange="E(()=>S.aus[${i}].m=this.value)"><button class="x" onclick="E(()=>S.aus.splice(${i},1))">✕</button></div>`).join("")||"<p class='muted'>Sem ausências.</p>";
 $("srv").innerHTML=S.srv.map((x,i)=>`<div class="srv"><input class="t1" list="svl" value="${esc(x.t)}" placeholder="Serviço" onchange="E(()=>S.srv[${i}].t=this.value)"><input value="${esc(x.c)}" placeholder="Viatura (marca/modelo)" onchange="E(()=>S.srv[${i}].c=this.value)"><button class="x xx" aria-label="Apagar" onclick="E(()=>S.srv.splice(${i},1))">✕</button><input value="${esc(x.p||"")}" placeholder="Matrícula" style="text-transform:uppercase" onchange="E(()=>S.srv[${i}].p=this.value.toUpperCase())"><input class="w2" value="${esc(x.r)}" placeholder="Responsáveis (separar por vírgula)" onchange="E(()=>S.srv[${i}].r=this.value)"></div>`).join("")||"<p class='muted'>Sem serviços.</p>";
 $("meta").innerHTML=(S.by?`Elaborado por <b>${esc(S.by)}</b> em ${new Date(S.at).toLocaleString("pt-PT")}. `:"Relatório ainda não guardado. ")+(S.apr?`<span class="tag ok">Aprovado por ${esc(S.apr)}</span>`:`<span class="tag">Pendente de aprovação</span>`);
 $("bap").textContent=S.apr?"Reabrir":"Aprovar";
 if(locked)document.querySelectorAll("#ed input,#ed .x,#ed .add").forEach(e=>e.disabled=true);
 $("wa").value=texto()}
function texto(){const L=(k,w)=>S[k][w].map(x=>`${x.n||"-"}: ${fmt(x.v)}`).join("\n");let t=`*Relatório do dia oficina ${dBR(date).slice(0,5)}*\n`;
 BL.forEach(([k,n],j)=>{if(j==2)t+=`\n*Registo da área de formação*\n`;t+=`\n*${j<2?n:n.split("· ")[1]}*\nSaldo inicial: ${fmt(S[k].ini)}\n`;if(S[k].ent.length)t+=L(k,"ent").replace(/^/gm,"Entrada - ")+"\n";t+=`*Total: ${fmt(T2(S[k]))}*\n`;t+=S[k].sai.length?`${SEC[k][1]}:\n`+L(k,"sai")+"\n":"Saídas: 0,00\n";t+=`*Saldo final: ${fmt(F2(S[k]))}*\n`});
 t+=`\n*Ausência no local de trabalho*\n`+(S.aus.map(x=>`${x.n} - (${x.m})`).join("\n")||"Nenhuma");
 t+=`\n\n*Serviço realizado*\n`+S.srv.map(x=>`\n${x.t}\nViatura: ${x.c}${x.p?" ("+x.p+")":""}\nResponsável\n${x.r.split(",").map(s=>s.trim()).filter(Boolean).join("\n")}`).join("\n");return t}
function copiar(){const a=$("wa");a.value=texto();document.querySelector("#v-dia details").open=true;a.select();try{navigator.clipboard.writeText(a.value).then(()=>alert("Texto copiado."),()=>document.execCommand("copy"))}catch(e){try{document.execCommand("copy")}catch(_){}}}
/* painel */
function line(v,w=640,h=190){if(v.length<2)return"<p class='muted'>Precisa de pelo menos 2 relatórios.</p>";const mx=Math.max(...v),mn=Math.min(...v),sp=mx-mn||1,p=v.map((y,i)=>[30+i*(w-50)/(v.length-1),h-24-(y-mn)/sp*(h-50)]);
 return`<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="Evolução do saldo"><polyline fill="none" stroke="var(--steel)" stroke-width="3" points="${p.map(x=>x.join(",")).join(" ")}"/>${p.map((x,i)=>`<circle cx="${x[0]}" cy="${x[1]}" r="4" fill="var(--acc)"><title>${fmt(v[i])} Kz</title></circle>`).join("")}<text x="4" y="14" font-size="11" fill="var(--mut)">${fmt(mx)}</text><text x="4" y="${h-8}" font-size="11" fill="var(--mut)">${fmt(mn)}</text></svg>`}
const sm=d=>{const s=DB[d];return{b:F2(s.banco),c:F2(s.caixa),d:sum(s.caixa.sai),v:s.srv.filter(x=>x.c.trim()).length,a:s.aus.filter(x=>x.n.trim()).length,ok:s.apr}};
function P(){const mo=OSL.filter(o=>o.dt.startsWith(today.slice(0,7))),Z=(a,f)=>a.reduce((t,o)=>t+f(o),0);
 $("pk2").innerHTML=[["Viaturas na oficina",OSL.filter(o=>o.es!=="Entregue").length],["Prontas p/ entrega",OSL.filter(o=>o.es==="Pronta").length],["Faturado (OS do mês)",fmt(Z(mo,tv))+" Kz"],["Recebido (OS do mês)",fmt(Z(mo,pg))+" Kz"],["Por receber (total)",fmt(Z(OSL,o=>tv(o)-pg(o)))+" Kz"]].map(([a,b])=>`<div class="kpi"><small>${a}</small><b>${b}</b></div>`).join("");
 $("c4").innerHTML=bars(ES.map(e=>[e,OSL.filter(o=>o.es===e).length]).filter(x=>x[1]),"var(--steel)"," viat.",x=>x);
 const ds=Object.keys(DB).sort(),has=ds.length>0;$("pe").hidden=has;$("ptitle").textContent="Painel financeiro";
 if(!has){$("pk").innerHTML="";$("c1").innerHTML=$("c2").innerHTML=$("c3").innerHTML="<p class='muted'>Sem dados.</p>";$("pl").innerHTML="";return}
 const last=sm(ds[ds.length-1]),ym=ds[ds.length-1].slice(0,7),md=ds.filter(d=>d.startsWith(ym)).map(sm);
 $("pk").innerHTML=[["Saldo Banco",fmt(last.b)+" Kz"],["Saldo Caixa",fmt(last.c)+" Kz"],["Despesas do mês",fmt(md.reduce((s,x)=>s+x.d,0))+" Kz"],["Viaturas no mês",md.reduce((s,x)=>s+x.v,0)],["Relatórios no mês",md.length],["Por aprovar",ds.filter(d=>!DB[d].apr).length]].map(([a,b])=>`<div class="kpi"><small>${a}</small><b>${b}</b></div>`).join("");
 const l14=ds.slice(-14);$("c1").innerHTML=bars(l14.map(d=>[dBR(d).slice(0,5),sm(d).d]),"var(--out)");$("c2").innerHTML=line(l14.map(d=>sm(d).b+sm(d).c));
 const cnt={};ds.filter(d=>d.startsWith(ym)).forEach(d=>DB[d].srv.forEach(x=>{if(x.c.trim()){const k=(x.t||"Outro").trim();cnt[k]=(cnt[k]||0)+1}}));
 $("c3").innerHTML=bars(Object.entries(cnt).sort((a,b)=>b[1]-a[1]).slice(0,6),"var(--steel)"," serv.",x=>x);
 $("pl").innerHTML=ds.slice(-8).reverse().map(d=>{const x=sm(d);return`<tr><td data-label="Data">${dBR(d)}</td><td class="n" data-label="Banco">${fmt(x.b)}</td><td class="n" data-label="Despesas">${fmt(x.d)}</td><td data-label="Estado">${x.ok?'<span class="tag ok">Aprovado</span>':'<span class="tag">Pendente</span>'}</td><td><button onclick="date='${d}';go('dia')">Abrir</button></td></tr>`}).join("")}
/* histórico */
function H(){if(!$("mm").value)$("mm").value=date.slice(0,7);$("mm").onchange=H;const ym=$("mm").value,ds=Object.keys(DB).sort().filter(d=>d.startsWith(ym)),a=ds.map(sm);
 $("ptitle").textContent="Resumo mensal · "+ym.split("-").reverse().join("/");const td=a.reduce((s,x)=>s+x.d,0),tv=a.reduce((s,x)=>s+x.v,0),ta=a.reduce((s,x)=>s+x.a,0);
 $("hk").innerHTML=[["Dias com relatório",a.length],["Despesas do mês",fmt(td)+" Kz"],["Média diária de despesas",fmt(a.length?td/a.length:0)+" Kz"],["Viaturas atendidas",tv],["Ausências",ta]].map(([k,v])=>`<div class="kpi"><small>${k}</small><b>${v}</b></div>`).join("");
 $("hr").innerHTML=ds.map((d,i)=>{const x=a[i];return`<tr><td data-label="Data">${dBR(d)}</td><td class="n" data-label="Banco">${fmt(x.b)}</td><td class="n" data-label="Caixa">${fmt(x.c)}</td><td class="n neg" data-label="Despesas">${fmt(x.d)}</td><td class="n" data-label="Viaturas">${x.v}</td><td class="n" data-label="Ausências">${x.a}</td><td data-label="Estado">${x.ok?"Aprovado":"Pendente"}</td><td class="noprint"><button onclick="date='${d}';go('dia')">Abrir</button></td></tr>`}).join("")||"<tr><td colspan='8' class='muted'>Sem relatórios neste mês.</td></tr>";
 const lx=a[a.length-1];$("hf").innerHTML=a.length?`<tr><td data-label="">Totais / último saldo</td><td class="n" data-label="Banco">${fmt(lx.b)}</td><td class="n" data-label="Caixa">${fmt(lx.c)}</td><td class="n" data-label="Despesas">${fmt(td)}</td><td class="n" data-label="Viaturas">${tv}</td><td class="n" data-label="Ausências">${ta}</td><td colspan="2"></td></tr>`:""}
async function csv(){const ym=$("mm").value,ds=Object.keys(DB).sort().filter(d=>d.startsWith(ym));let t="Data;Banco;Caixa;Despesas;Viaturas;Ausencias;Estado\n"+ds.map(d=>{const x=sm(d);return[dBR(d),x.b,x.c,x.d,x.v,x.a,x.ok?"Aprovado":"Pendente"].join(";")}).join("\n");
 try{const dl=await window.claude.use("downloads");if(!dl)throw 0;await dl.save({filename:`caixa-${ym}.csv`,data:"\ufeff"+t})}catch(e){alert("Não foi possível guardar o ficheiro neste ambiente.")}}
/* utilizadores */
function U(){$("ptitle").textContent="Utilizadores";$("ul").innerHTML=USERS.map((x,i)=>`<div class="r"><span><b>${esc(x.n)}</b><br><small class="muted">${esc(x.u)} · ${RN[x.r]}</small></span>${x.u===ME.u?'<span class="tag">Você</span>':`<button class="x" onclick="rmU(${i})">Remover</button>`}</div>`).join("")}
function rmU(i){if(confirm("Remover "+USERS[i].n+"?")){USERS.splice(i,1);sv("aa_users",USERS);U()}}
$("uf").onsubmit=async e=>{e.preventDefault();const u=$("uu").value.trim().toLowerCase();if(USERS.some(x=>x.u===u)){$("ue").textContent="Esse utilizador já existe.";return}
 const s=crypto.randomUUID();USERS.push({u,n:$("un").value.trim(),r:$("ur").value,s,h:await hash($("up").value,s)});sv("aa_users",USERS);e.target.reset();$("ue").textContent="";U()};
/* viaturas / ordens de serviço */
const ES=["Recebida","Em diagnóstico","Aguarda peça","Em reparação","Pronta","Entregue"],today=new Date().toLocaleDateString("sv");
let OSL=ld("aa_os",[]),O=null;const tv=o=>sum(o.serv)+sum(o.pec),pg=o=>sum(o.pag),sv2=()=>sv("aa_os",OSL);
const tg=e=>`<span class="tag ${e==="Entregue"||e==="Pronta"?"ok":e==="Aguarda peça"?"w":""}">${e}</span>`;
$("osf").innerHTML='<option value="">Todos os estados</option>'+ES.map(e=>`<option>${e}</option>`).join("");$("osq").oninput=$("osf").onchange=()=>osl();
function osl(){$("os-list").hidden=false;$("os-ed").hidden=true;$("ptitle").textContent="Entrada de viaturas";const q=$("osq").value.trim().toLowerCase(),f=$("osf").value;
 const L=OSL.filter(o=>(!f||o.es===f)&&(!q||[o.no,o.mt,o.cn,o.cm].join(" ").toLowerCase().includes(q))).sort((a,b)=>(b.dt+b.no).localeCompare(a.dt+a.no));
 $("osb").innerHTML=L.map(o=>{const d=tv(o)-pg(o);return`<tr><td data-label="OS"><b>${o.no}</b></td><td data-label="Entrada">${dBR(o.dt)}</td><td data-label="Viatura">${esc(o.cm||"—")} <small class="muted">${esc(o.mt||"")}</small></td><td data-label="Cliente">${esc(o.cn||"—")}</td><td data-label="Estado">${tg(o.es)}</td><td class="n" data-label="Total">${fmt(tv(o))}</td><td class="n ${d>0?"neg":""}" data-label="Em dívida">${fmt(d)}</td><td><button onclick="O=OSL.find(x=>x.id===${o.id});ose()">Abrir</button></td></tr>`}).join("")||"<tr><td colspan='8' class='muted'>Nenhuma viatura encontrada. Toque em “+ Nova entrada”.</td></tr>"}
function novaOS(){const n=Math.max(0,...OSL.map(o=>+o.no.slice(3)))+1;O={id:Date.now(),no:"OS-"+String(n).padStart(4,"0"),dt:today,es:"Recebida",cn:"",ct:"",cm:"",mt:"",km:"",rs:"",qx:"",ob:"",serv:[],pec:[],pag:[],by:ME.n};OSL.push(O);sv2();ose()}
function EO(fn){fn();O.by=ME.n;sv2();ose()}
function osBack(){if(!O.cn&&!O.mt&&!O.cm&&!sum(O.serv)){OSL=OSL.filter(x=>x!==O);sv2()}O=null;osl()}
function osDel(){if(confirm("Eliminar "+O.no+"?")){OSL=OSL.filter(x=>x!==O);sv2();O=null;osl()}}
function ose(){$("os-list").hidden=true;$("os-ed").hidden=false;$("ptitle").innerHTML=`Ordem de serviço <b>${O.no}</b> · Entrada em ${dBR(O.dt)}`;
 const fl=[["cn","Nome do cliente"],["ct","Telefone","tel"],["cm","Viatura (marca/modelo)"],["mt","Matrícula"],["km","Quilometragem","number"],["dt","Data de entrada","date"],["rs","Mecânico responsável"]].map(([k,l,t])=>`<label>${l}<input ${t?`type="${t}"`:""} ${k==="mt"?'style="text-transform:uppercase"':""} value="${esc(O[k]||"")}" onchange="EO(()=>O.${k}=this.value${k==="mt"?".toUpperCase()":""})"></label>`).join("");
 const ta=(k,l)=>`<section class="box"><h3>${l}</h3><textarea class="ta" onchange="EO(()=>O.${k}=this.value)">${esc(O[k]||"")}</textarea></section>`;
 const ol=(w,t)=>`<section class="box"><h3>${t}</h3>${O[w].map((x,i)=>`<div class="r"><input value="${esc(x.n)}" placeholder="Descrição" onchange="EO(()=>O.${w}[${i}].n=this.value)"><input class="v" value="${fmt(x.v)}" inputmode="decimal" onchange="EO(()=>O.${w}[${i}].v=num(this.value))"><button class="x" aria-label="Apagar" onclick="EO(()=>O.${w}.splice(${i},1))">✕</button></div>`).join("")||"<p class='muted'>Sem registos.</p>"}<div class="r tot"><span>Subtotal</span><span>${fmt(sum(O[w]))} Kz</span></div><button class="add noprint" onclick="EO(()=>O.${w}.push({n:'',v:0}))">+ linha</button></section>`;
 const ph=(O.ct||"").replace(/\D/g,""),to=ph.length===9?"244"+ph:ph,d=tv(O)-pg(O),
 msg=encodeURIComponent(`Olá ${O.cn}, a sua viatura ${O.cm} (${O.mt}) ${O.es==="Pronta"?"está pronta para levantamento":"está em estado: "+O.es} na Auto Avan. Total: ${fmt(tv(O))} Kz. Em dívida: ${fmt(d)} Kz.`);
 $("os-ed").innerHTML=`<div class="bar0 noprint"><button onclick="osBack()">← Lista</button><h2>${O.no}</h2><select aria-label="Estado" onchange="EO(()=>{O.es=this.value;if(this.value==='Entregue'&&!O.ds)O.ds=today})">${ES.map(e=>`<option ${e===O.es?"selected":""}>${e}</option>`).join("")}</select>${ph?`<a class="btn" target="_blank" rel="noopener" href="https://wa.me/${to}?text=${msg}">Avisar cliente</a>`:""}<button class="pri" onclick="window.print()">Imprimir OS</button>${ME.r==="dir"?'<button onclick="osDel()">Eliminar</button>':""}</div>
 <div class="kpis"><div class="kpi"><small>Estado</small><b>${O.es}</b></div><div class="kpi"><small>Total a pagar</small><b>${fmt(tv(O))} Kz</b></div><div class="kpi"><small>Pago</small><b>${fmt(pg(O))} Kz</b></div><div class="kpi"><small>Em dívida</small><b class="${d>0?"neg":"pos"}">${fmt(d)} Kz</b></div></div>
 <section class="box"><h3>Cliente e viatura</h3><div class="fg">${fl}</div></section>
 <div class="grid">${ta("qx","Avaria / pedido do cliente")}${ta("ob","Estado da viatura à entrada")}</div>
 <div class="grid">${ol("serv","Serviços realizados")}${ol("pec","Peças e materiais")}</div>${ol("pag","Pagamentos recebidos")}
 <p class="muted" style="font-size:13px">Registado por ${esc(O.by||"")}${O.ds?" · Entregue em "+dBR(O.ds):""}</p>
 <div class="printonly sign"><div>Cliente</div><div>Auto Avan, Lda</div></div>`}
/* início */
lmode();try{const u=sessionStorage.getItem("aa_me"),x=USERS.find(y=>y.u===u);if(x)entrar(x)}catch(e){}
</script>
